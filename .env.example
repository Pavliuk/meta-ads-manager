# Meta App (developers.facebook.com) — App ID/Secret вашого застосунку
META_APP_ID=
META_APP_SECRET=

# Access token з правами ads_management для потрібного рекламного акаунту
# (System User token у Business Manager — не прив'язаний до особистого логіну
# і не протухає, на відміну від User Access Token)
META_ACCESS_TOKEN=

# ID рекламного акаунту, напр. act_1234567890 (можна без префікса act_)
META_AD_ACCOUNT_ID=

# ID Facebook-сторінки, від імені якої публікуються оголошення (обов'язково для ad create-creative)
META_PAGE_ID=

# --- Лендинг-бот (landing_bot) — приймає трафік і фіксує джерело ---

# Токен Telegram-бота, на який веде реклама (@BotFather -> /newbot)
LANDING_BOT_TOKEN=

# Telegram user id адміністратора(-ів) через кому — лише вони бачать /traffic.
# Дізнатись свій tg_id: напишіть @userinfobot
ADMIN_IDS=
